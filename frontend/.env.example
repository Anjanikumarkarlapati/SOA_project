# Supabase Google sign-in (frontend). Copy to .env and fill from your Supabase project.
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set to "true" to show the demo-account panel on the sign-in page. Defaults to on in dev and
# off in production builds, so deployed instances do not advertise working credentials.
VITE_SHOW_DEMO_ACCOUNTS=
