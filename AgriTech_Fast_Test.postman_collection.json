          "name": "Toggle schedule off (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/irrigation/schedules/{{scheduleId}}/active",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            }
