    {
      "name": "Service discovery (Eureka)",
      "item": [
        {
          "name": "Registered services",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{eurekaUrl}}/eureka/apps",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const apps = pm.response.json().applications.application;",
                  "const names = apps.map(a => a.name);",
                  "['API-GATEWAY','AUTH-SERVICE','SENSOR-SERVICE','CROP-SERVICE','IRRIGATION-SERVICE'].forEach(n =>",
                  "  pm.test(n + ' is registered', () => pm.expect(names).to.include(n)));",
                  "apps.forEach(a => a.instance.forEach(i => console.log(a.name, i.instanceId, i.status)));",
                  "const ids = apps.flatMap(a => a.instance.map(i => i.instanceId));",
                  "pm.test('instance ids are unique', () => pm.expect(new Set(ids).size).to.eql(ids.length));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sensor service instances",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{eurekaUrl}}/eureka/apps/SENSOR-SERVICE",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('at least one UP instance', () => pm.expect(pm.response.json().application.instance.some(i => i.status === 'UP')).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Gateway & Actuator",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Gateway status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/status"
          }
        },
        {
          "name": "Unknown path (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/sensors/no/such/path"
          }
        },
        {
          "name": "Actuator info",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/info"
          }
        }
      ]
    },
    {
      "name": "Logout",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The token is revoked now; clear it so the next request logs in again.",
                  "pm.collectionVariables.unset('token');",
                  "if (pm.environment.has('token')) pm.environment.unset('token');"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "eurekaUrl",
      "value": "http://localhost:8761"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "farmerToken",
      "value": ""
    },
    {
      "key": "scheduleId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login: access tokens last 15 min, so keep {{token}} / {{farmerToken}} fresh and any",
          "// request can be sent on its own, without running Login first.",
          "const expiresAt = (t) => { try { return JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))).exp * 1000; } catch (e) { return 0; } };",
          "const ensure = (name, email, password) => {",
          "  if (expiresAt(pm.variables.get(name) || '') > Date.now() + 30000) return;",
          "  pm.sendRequest({",
          "    url: pm.variables.get('baseUrl') + '/api/auth/login', method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ email, password }) },",
          "  }, (err, res) => {",
          "    if (err || res.code !== 200) return console.warn('auto-login failed for ' + email, err || res.code);",
          "    const j = res.json();",
          "    pm.collectionVariables.set(name, j.token);",
          "    if (pm.environment.has(name)) pm.environment.set(name, j.token);",
          "    if (name === 'token') pm.collectionVariables.set('refreshToken', j.refreshToken);",
          "  });",
          "};",
          "ensure('token', 'admin@agritech.io', 'admin1234');",
          "ensure('farmerToken', 'farmer@agritech.io', 'farmer1234');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const m = pm.info.requestName.match(/\\(expect ([\\d|]+)\\)/);",
          "const ok = m ? m[1].split('|').map(Number) : null;",
          "pm.test(pm.info.requestName + ' -> ' + pm.response.code, () => ok ? pm.expect(ok).to.include(pm.response.code) : pm.expect(pm.response.code).to.be.within(200, 299));"
        ]
      }
    }
  ]
}