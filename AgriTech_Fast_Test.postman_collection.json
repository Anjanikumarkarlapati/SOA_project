{
  "info": {
    "name": "AgriTech Fast Test Collection",
    "description": "Every AgriTech API endpoint through the gateway. Run top to bottom (Collection Runner): it logs in, creates, reads, updates and deletes its own test data, then logs out. Names ending \"(expect NNN)\" check that status; the rest must be 2xx.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@agritech.io\",\n  \"password\": \"admin1234\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('token returned', () => pm.expect(j.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', j.token);",
                  "if (pm.environment.has('token')) pm.environment.set('token', j.token);",
                  "pm.collectionVariables.set('refreshToken', j.refreshToken);",
                  "pm.collectionVariables.set('runId', Date.now().toString(36).toUpperCase());"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (farmer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer@agritech.io\",\n  \"password\": \"farmer1234\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('farmerToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@agritech.io\",\n  \"password\": \"nope\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('role is ADMIN', () => pm.expect(pm.response.json().role).to.eql('ADMIN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register user (expect 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pm-{{runId}}@agritech.io\",\n  \"password\": \"password123\",\n  \"role\": \"FARMER\",\n  \"farmId\": \"FARM-001\",\n  \"displayName\": \"Postman User\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Register duplicate (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@agritech.io\",\n  \"password\": \"password123\",\n  \"role\": \"ADMIN\",\n  \"farmId\": \"FARM-001\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);",
                  "if (pm.environment.has('token')) pm.environment.set('token', j.token);",
                  "pm.collectionVariables.set('refreshToken', j.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Google sign-in with bogus token (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/google",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessToken\": \"bogus\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "No token (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/sensors",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Sensors",
      "item": [
        {
          "name": "Register sensor (expect 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/sensors/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"SENSOR-PM-{{runId}}\",\n  \"farmId\": \"FARM-001\",\n  \"sensorType\": \"soil-moisture-temperature\",\n  \"fieldId\": \"CROP-FIELD-01\",\n  \"latitude\": 17.4,\n  \"longitude\": 78.47\n}"
            }
          }
        },
        {
          "name": "Register same sensor again (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/sensors/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"SENSOR-PM-{{runId}}\",\n  \"farmId\": \"FARM-001\",\n  \"sensorType\": \"soil-moisture-temperature\"\n}"
            }
          }
        },
        {
          "name": "Get sensor",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/sensors/SENSOR-PM-{{runId}}"
          }
        },
        {
          "name": "Update sensor (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/sensors/SENSOR-PM-{{runId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fieldId\": \"CROP-FIELD-02\",\n  \"sensorType\": \"soil-ph\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('field updated', () => pm.expect(pm.response.json().fieldId).to.eql('CROP-FIELD-02'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List sensors",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/sensors?page=0&size=25"
          }
        },
        {
          "name": "List offline sensors",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/sensors?health=OFFLINE"
          }
        },
        {
          "name": "Sensor summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/sensors/summary"
          }
        }
      ]
    },
    {
      "name": "Telemetry",
      "item": [
        {
          "name": "Ingest telemetry",
          "request": {
            "method": "POST",
            "header": [
