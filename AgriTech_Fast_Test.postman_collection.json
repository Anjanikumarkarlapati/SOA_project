    {
      "name": "Irrigation",
      "item": [
        {
          "name": "Create schedule (expect 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/irrigation/schedules",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cropId\": \"CROP-FIELD-01\",\n  \"valveId\": \"VALVE-FIELD-01\",\n  \"recurrence\": \"WEEKLY\",\n  \"daysOfWeek\": [\n    \"MONDAY\",\n    \"THURSDAY\"\n  ],\n  \"startTime\": \"06:30\",\n  \"durationMinutes\": 20,\n  \"skipIfMoist\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('scheduleId', pm.response.json().scheduleId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create schedule with bad day name (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/irrigation/schedules",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cropId\": \"CROP-FIELD-01\",\n  \"valveId\": \"VALVE-FIELD-01\",\n  \"recurrence\": \"WEEKLY\",\n  \"daysOfWeek\": [\n    \"MON\"\n  ],\n  \"startTime\": \"06:30\",\n  \"durationMinutes\": 20\n}"
            }
          }
        },
        {
          "name": "Get schedule",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/irrigation/schedules/{{scheduleId}}"
          }
        },
        {
          "name": "Update schedule (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/irrigation/schedules/{{scheduleId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"07:15\",\n  \"durationMinutes\": 30\n}"
            }
