                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/telemetry/ingest",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"readings\": [\n    {\n      \"deviceId\": \"SENSOR-FARM01-001\",\n      \"soilMoisture\": 60.2,\n      \"soilTemperature\": 22.5,\n      \"ph\": 6.5,\n      \"batteryPercent\": 88\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Ingest with an empty reading (rejected, not 500)",
