# PostgreSQL Database Configuration
# Copy to .env and populate with actual values

DATABASE_URL=postgresql://postgres:your_password@localhost:5432/soa_hackathon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=soa_hackathon
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application
NODE_ENV=development
# Set true only in local/demo environments to show pre-filled demo login buttons
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=false
