# Local PostgreSQL connection (created by scripts/db-setup.ps1).
# The services fall back to one persistent H2 file per service when DB_URL is unset.
DB_URL=jdbc:postgresql://localhost:5432/agritech
DB_USERNAME=agritech
DB_PASSWORD=replace-with-the-password-from-db-setup

# Signing secrets - REQUIRED. There is no built-in default any more: a service or the gateway
# refuses to start if either value is missing, shorter than 32 characters, or still set to the
# development default that used to be committed here.
#
# scripts/stack.ps1 generates both values into .env on its first run, so local demos need no
# manual step. Elsewhere, generate two *different* values:
#   openssl rand -hex 32
#
# AGRITECH_JWT_SECRET      signs/verifies the app access tokens (auth-service + api-gateway)
# AGRITECH_INTERNAL_SECRET signs the gateway identity headers (gateway + every service)
#
# Changing AGRITECH_JWT_SECRET invalidates every token already issued; clients have to log in again.
AGRITECH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AGRITECH_INTERNAL_SECRET=replace-with-a-different-random-secret-at-least-32-characters
